# TMDB API Configuration
# Get your API key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=AAAA

# Default Region & Currency Settings (UK / GBP)
DEFAULT_REGION=GB
DEFAULT_CURRENCY_SYMBOL=£

# Workflow Filtering Parameters
MIN_IMDB_RATING=6.0

# Open WebUI admin API key, used by setup_clients.py --openwebui
OPENWEBUI_API_KEY=sk-abcdef